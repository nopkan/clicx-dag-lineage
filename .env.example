OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini

# AWS SSO for "Import data" in Docker. These say where to sign in; they are not credentials.
# Each person who uses the site signs in with their own AWS account (a link + code on the import page).
LINEAGE_AWS_SSO_START_URL=
LINEAGE_AWS_SSO_REGION=
LINEAGE_AWS_SSO_ACCOUNT_ID=
LINEAGE_AWS_SSO_ROLE_NAME=
LINEAGE_AWS_ROLE_ARN=
LINEAGE_AWS_REGION=
